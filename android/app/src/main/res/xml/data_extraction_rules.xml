<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing this app stores should leave the device. Excluding the whole
     app domain is blunt on purpose: it cannot be wrong by omission the way an
     allow-list can. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
