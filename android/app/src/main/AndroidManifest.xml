<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Required, not optional: with no USB host controller there is nothing
         for this app to do. Marking it required also keeps it off devices that
         cannot run it, rather than installing and failing at first use. -->
    <uses-feature
        android:name="android.hardware.usb.host"
        android:required="true" />

    <!-- Argon2 can take seconds and allocate up to a gigabyte. Without a
         foreground service the low-memory killer is free to take the app in the
         middle of that, which looks like a random crash rather than the known
         risk it is. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- API 33+ requires this before the service's notification will show. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.LuksAndroid"
        android:supportsRtl="true"
        android:largeHeap="true"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false">

        <!-- android:largeHeap is here for the same reason as the foreground
             service: the Argon2 allocation is the largest single thing this app
             does. It raises the ceiling; it does not guarantee the allocation.

             android:allowBackup=false and the empty extraction rules keep
             anything derived from the drive out of cloud backup and out of
             device-to-device transfer. -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Launch when a mass-storage device is plugged in. Android grants
                 permission for that specific device implicitly when the app is
                 started this way, which skips the permission dialog. -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/device_filter" />
        </activity>

        <!-- The type here must match the one passed to startForeground(), or
             API 34+ throws instead of starting the service. -->
        <service
            android:name=".UnlockService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
